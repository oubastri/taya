# Supabase project credentials (find these in your Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Data mode: "mock" uses localStorage + placeholder user (handle "me"). With Supabase login you must use:
# NEXT_PUBLIC_DATA_MODE=real
# so the app loads your `profiles` row and middleware refreshes the session cookie.
NEXT_PUBLIC_DATA_MODE=mock
