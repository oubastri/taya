# Supabase (required when NEXT_PUBLIC_DATA_MODE=real)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Data mode:
# - mock: localStorage + optional seed data; middleware does not enforce Supabase auth
# - real: Supabase auth + DB; middleware protects app routes
# After changing, restart `npm run dev`.
NEXT_PUBLIC_DATA_MODE=mock

# Show dev FAB + menu when running `next start` (e.g. preview). Off by default; always on in `next dev`.
# NEXT_PUBLIC_DEV_MENU=1

# Optional: Plausible Analytics domain (hostname only, e.g. app.example.com)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
